{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowJs": false,
    "resolveJsonModule": true
  },
  "include": [
    "main.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.ts",
    "../src/contracts/schema.ts",
    "../src/contracts/contract-file-schema.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
