{
  "vmFormatVersion": 1,
  "contract": {
    "version": 1,
    "name": "project-status",
    "description": "Compile a project status brief for a tagged project. Discovers all\ndocs whose frontmatter `project: <key>` matches, clusters them, and\nhands the result to compile_brief. Useful for weekly status rollups\nwhere the universe of relevant docs is tag-defined.\n",
    "inputs": {
      "project_key": {
        "type": "string",
        "description": "Frontmatter project key (e.g. \"atlas-1\")."
      },
      "freshness_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365,
        "default": 30,
        "description": "Filter docs to those modified within the last N days."
      }
    },
    "required": [
      "project_key"
    ],
    "sources": {
      "default_source": {
        "handle": "obsidian-fs://test-vault",
        "required": true
      }
    },
    "sinks": {
      "default_sink": {
        "handle": "_memory/_briefs",
        "required": true
      }
    },
    "assembly": [
      {
        "as": "tagged_docs",
        "verb": "query_frontmatter",
        "args": {
          "where": {
            "project": "{{inputs.project_key}}"
          }
        }
      },
      {
        "as": "clustered",
        "verb": "cluster",
        "args": {
          "seed_doc_ids": "{{tagged_docs.doc_ids}}",
          "method": "edge-community"
        }
      },
      {
        "as": "compiled",
        "verb": "compile_brief",
        "args": {
          "vault": "test-vault",
          "target": "{{inputs.project_key}}--status",
          "source_doc_ids": "{{tagged_docs.doc_ids}}",
          "purpose": "Project status brief",
          "max_tokens": 2500
        }
      }
    ],
    "output_shape": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "object"
        },
        "write_back": {
          "type": "object",
          "properties": {
            "doc_id": {
              "type": "string"
            }
          },
          "required": [
            "doc_id"
          ]
        }
      },
      "required": [
        "write_back"
      ]
    },
    "write_back": {
      "sink": "{{default_sink}}",
      "document_kind": "brief",
      "properties": {
        "target": "{{inputs.project_key}}--status",
        "source": "agent",
        "purpose": "Project status brief"
      },
      "body_from": "{{compiled.body}}"
    }
  },
  "editor": {
    "selection": null,
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    },
    "nodes": [
      {
        "id": "step-0",
        "position": {
          "x": 0,
          "y": 0
        },
        "size": {
          "width": 200,
          "height": 100
        }
      },
      {
        "id": "step-1",
        "position": {
          "x": 220,
          "y": 0
        },
        "size": {
          "width": 200,
          "height": 100
        }
      },
      {
        "id": "step-2",
        "position": {
          "x": 440,
          "y": 0
        },
        "size": {
          "width": 200,
          "height": 100
        }
      }
    ],
    "preservedComments": []
  }
}
