node_modules/
# Build output. Never committed: nothing reads the checked-in bundle
# (npm publish, CI smoketest and the release workflow each rebuild it),
# so a committed copy only drifts silently — v2.3.2 and v2.4.0 both
# shipped a tag whose dist/ was one version stale. `prepublishOnly`
# guarantees a fresh build for the npm tarball instead.
dist/
*.log
.DS_Store
**/.DS_Store
.env
.env.local
coverage/
.vitest/
*.tsbuildinfo
# Symlink created by `npm link --prefix .`; the canonical bin entry is
# resolved via package.json#bin from the global node_modules instead.
bin/

# Internal roadmap notes — kept locally for maintainer use, not part of
# the public repo or npm tarball.
docs/optimization-todos/
docs/dev/

# Claude Code workspace artifacts (worktree state, scheduled-task locks).
# Session-local; never committed.
.claude/

# GSD tooling state (.pi/gsd) — session-local planning cache, not part of
# the repo or npm tarball.
.pi/

# GSD planning artifacts (roadmap, phase plans, research notes). Maintainer
# working material, never part of the npm tarball. Tracked until 2026-08-09;
# `git log -- .planning/` still reaches the history, and the last committed
# state is at 410c723.
.planning/

# Working-issue notes (paper trail, not part of release)
ISSUE-*.md
